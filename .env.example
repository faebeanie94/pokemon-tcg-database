# Path to the SQLite catalog (shared by pokedb and the Next.js app)
# POKEDB_DB=build/pokemon_tcg.sqlite
# DATABASE_PATH=build/pokemon_tcg.sqlite

# Pokémon export scripts (apis/)
# These are read from the environment; never hard-code them into the scripts.

# https://pikaqian.com — free tier is 500 requests per MONTH
PIKAQIAN_API_KEY=

# https://pokewallet.io — free tier is 100 requests/hour, 1000/day
POKEWALLET_API_KEY=

# https://dev.pokemontcg.io — free, optional but strongly recommended
POKEMONTCGIO_API_KEY=

# Most multi-game sources need no key:
#   TCGCSV, Scryfall, YGOPRODeck, Lorcast, GoAgain
# apitcg.com requires a free API key (https://apitcg.com/platform)
APITCG_API_KEY=
