{
  "name": "pokemon-tcg-database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "build:index": "tsx scripts/build-match-index.ts",
    "refresh": "PYTHONPATH=src python3 -m pokedb update && pnpm build:index",
    "refresh:games": "PYTHONPATH=src python3 -m pokedb update --source tcgcsv --source ygoprodeck --source lorcast --source goagain --source apitcg && pnpm build:index",
    "fetch:mtg": "PYTHONPATH=src python3 -m pokedb fetch --source scryfall",
    "fetch:onepiece": "PYTHONPATH=src python3 -m pokedb fetch --source tcgcsv --game onepiece && PYTHONPATH=src python3 -m pokedb fetch --source apitcg --game onepiece",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "exceljs": "^4.4.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
